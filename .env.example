PORT=3000
NODE_ENV=development
# Required in production: strong random secret (>= 32 chars). Never commit real values.
JWT_SECRET=
# Optional: MongoDB connection for Mongoose layer (do not point to production from dev/test)
MONGODB_URI=
# Development-only opt-ins (must remain false/unset in production)
ENABLE_DEV_DEMO_LOGIN=false
ENABLE_DEV_SEED=false
ENABLE_DEV_TESTS=false