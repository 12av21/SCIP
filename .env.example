PORT=3000
NODE_ENV=development
# Required in production: strong random secret (>= 32 chars). Never commit real values.
JWT_SECRET=
# Persistence backend selector (controlled): json = active file-backed runtime (default/safe fallback).
# MongoDB repository runtime is not yet integrated/cut over; keep json until integration is explicitly verified.
DATABASE_DRIVER=json
# Optional: MongoDB connection for Mongoose lifecycle (isolated local dev only, e.g. mongodb://127.0.0.1:27017/scip_dev).
# Do not point to production, Atlas, or existing external/user databases. Runtime data operations remain JSON-backed until integration is complete.
MONGODB_URI=
# Development-only opt-ins (must remain false/unset in production)
ENABLE_DEV_DEMO_LOGIN=True
ENABLE_DEV_SEED=True
ENABLE_DEV_TESTS=True