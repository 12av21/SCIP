PORT=3000
NODE_ENV=development

# --- Clerk Authentication (Phase 3.1) ---
# Clerk is the Identity Provider. SCIP remains the application data source and RBAC authority.
# Publishable key is safe to expose in the browser (Vite VITE_ prefix); it is NOT a secret.
VITE_CLERK_PUBLISHABLE_KEY=
# Server-side secret used to verify Clerk session tokens. Required in production (>= 32 chars). Never commit real values.
CLERK_SECRET_KEY=
# Where Clerk redirects after logout (optional; defaults to /sign-in).
CLERK_LOGOUT_URL=
# Comma-separated list of allowed frontend origins for CORS (dev + prod), e.g. http://localhost:3000,https://app.example.com
CORS_ORIGINS=
# Absolute base URL used to build verification/email links (e.g. https://app.example.com). Defaults to http://localhost:3000.
APP_BASE_URL=

# DEPRECATED (Phase 3.1): JWT_SECRET is no longer read by code after the Clerk migration.
# Clerk now verifies tokens server-side; keep empty.
JWT_SECRET=
# Persistence backend selector (controlled): json = active file-backed runtime (default/safe fallback).
# MongoDB repository runtime is not yet integrated/cut over; keep json until integration is explicitly verified.
DATABASE_DRIVER=json
# Optional: MongoDB connection for Mongoose lifecycle (isolated local dev only, e.g. mongodb://127.0.0.1:27017/scip_dev).
# Do not point to production, Atlas, or existing external/user databases. Runtime data operations remain JSON-backed until integration is complete.
MONGODB_URI=
# Development-only opt-ins (must remain false/unset in production)
# DEPRECATED (Phase 3.1): ENABLE_DEV_DEMO_LOGIN is no longer read by code (demo role switching removed with Clerk migration).
ENABLE_DEV_DEMO_LOGIN=False
ENABLE_DEV_SEED=True
ENABLE_DEV_TESTS=True

# --- Email & SMS Verification Providers (Phase 3) ---
# Provider-independent: console/mock in development, real adapters required for production.
# Set EMAIL_PROVIDER=console|mock|sendgrid|ses|smtp and SMS_PROVIDER=console|mock|twilio|aws-sns|msg91|gupshup
# Real provider credentials are required for production email/SMS delivery. Not configured by default.
EMAIL_PROVIDER=console
SMS_PROVIDER=console
EMAIL_FROM=noreply@scip.gov
EMAIL_FROM_NAME=SCIP Portal
SMS_FROM=+91-0000000000
# SendGrid (optional real provider)
SENDGRID_API_KEY=
# AWS SES (optional real provider)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Twilio (optional real provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# MSG91 / Gupshup (optional real SMS providers)
MSG91_AUTH_KEY=
GUPSHUP_API_KEY=

# --- AI Service Integration (Phase 2.1) ---
# Python FastAPI microservice integration. Disabled by default; the TypeScript AI
# engine remains the primary, always-available fallback.
# Set AI_SERVICE_ENABLED=true and AI_SERVICE_URL to route supported capabilities to Python.
# Python failure is never fatal: the adapter falls back to the local TypeScript engine.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_ENABLED=false
AI_SERVICE_TIMEOUT_MS=5000
# NOTE: /embed, /embed-batch and /semantic-similarity require the optional Python
# dependency `sentence-transformers` (pip install sentence-transformers). Without it
# those endpoints return HTTP 503 and the adapter falls back to the local TF-IDF engine.
# Image analysis (/analyze-image) is optional and also falls back to a local heuristic.

# --- LLM Intelligence Agent (R2) ---
# When GEMINI_API_KEY is set, the Intelligence Agent uses a real LLM (Gemini) to
# select and invoke the deterministic intelligence tools, then synthesize a brief.
# Without a key, the agent uses the deterministic rules-based pipeline (always available).
# The LLM never invents data: it can only call the tools and summarize their results.
GEMINI_API_KEY=
# Optional alias; GEMINI_API_KEY takes precedence.
GOOGLE_API_KEY=
# Model id used for tool-calling + synthesis (default gemini-2.0-flash).
LLM_MODEL=gemini-2.0-flash
# Hard timeout per model call (ms). On timeout the agent falls back to the rules engine.
LLM_AGENT_TIMEOUT_MS=20000
# Max tool-call round trips before forcing a synthesis from gathered evidence.
LLM_AGENT_MAX_ITERATIONS=6
# Max characters of each tool result sent back to the model.
LLM_AGENT_MAX_TOOL_CHARS=4000
# Set to false to force the deterministic agent even when a key is present.
LLM_AGENT_ENABLED=true